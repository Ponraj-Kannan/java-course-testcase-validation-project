# ── Supabase Database & Auth ──────────────────────────────────────────────────
# Supabase project URL (used server-side and exposed to client)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (used on client with RLS)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SERVER-SIDE ONLY — NEVER expose to frontend or client bundle)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Zoho OAuth 2.0 ────────────────────────────────────────────────────────────
# Client ID is also exposed to the frontend via VITE_ prefix (safe — it's public)
VITE_ZOHO_CLIENT_ID=your_zoho_client_id_here

# Zoho accounts domain — change to https://accounts.zoho.in for India DC,
# https://accounts.zoho.eu for EU, https://accounts.zoho.com.au for AU, etc.
VITE_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Server-side only — never exposed to the browser
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# ── OneCompiler API (RapidAPI / Direct) ─────────────────────────────────────────
# Optional: RapidAPI key for OneCompiler API (free tier gives credits/requests)
RAPIDAPI_KEY=oc_44ykknsyr_44ykknsza_405c70093ccd76442f4cb5d9a87ba3bff6821ba713bfdcec
# Optional: Custom remote execution VM URL or fallback
# VITE_EXECUTION_API_URL=
# VITE_EXECUTION_API_KEY=

